{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/products/:id",
            "destination": "/api/products"
        },
        {
            "source": "/api/outings/:id",
            "destination": "/api/outings"
        },
        {
            "source": "/api/users/:path*",
            "destination": "/api/users/[...path]"
        },
        {
            "source": "/api/gallery/categories",
            "destination": "/api/gallery/[...path]"
        },
        {
            "source": "/api/gallery/category/:category",
            "destination": "/api/gallery/[...path]"
        },
        {
            "source": "/api/gallery/:id",
            "destination": "/api/gallery/[...path]"
        },
        {
            "source": "/api/gallery",
            "destination": "/api/gallery/[...path]"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Credentials",
                    "value": "true"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
                }
            ]
        }
    ]
}